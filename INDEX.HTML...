<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Construtor de Átomos Interativo</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #0d1b2a 100%);
    color: #e0e0e0;
    min-height: 100vh;
    overflow-x: hidden;
  }
  .header {
    background: linear-gradient(90deg, #1e3a5f, #2d5a87, #1e3a5f);
    padding: 12px 20px;
    text-align: center;
    border-bottom: 3px solid #4fc3f7;
    box-shadow: 0 4px 15px rgba(79,195,247,0.3);
  }
  .header h1 {
    font-size: 1.6em;
    color: #4fc3f7;
    text-shadow: 0 0 10px rgba(79,195,247,0.5);
  }
  .header p { color: #90caf9; font-size: 0.9em; margin-top: 4px; }
  .main-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 12px;
    padding: 12px;
    max-width: 1400px;
    margin: 0 auto;
  }
  @media (max-width: 1024px) {
    .main-container { grid-template-columns: 1fr 1fr; }
    .right-panel { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .main-container { grid-template-columns: 1fr; }
  }
  .panel {
    background: rgba(20,30,60,0.85);
    border: 1px solid rgba(79,195,247,0.3);
    border-radius: 12px;
    padding: 14px;
    backdrop-filter: blur(10px);
  }
  .panel-title {
    font-size: 1.05em;
    font-weight: bold;
    color: #4fc3f7;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(79,195,247,0.3);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 8px 0;
    padding: 6px 10px;
    background: rgba(0,0,0,0.3);
    border-radius: 8px;
  }
  .controls-row label {
    font-weight: bold;
    font-size: 0.95em;
    min-width: 90px;
  }
  .controls-row .value {
    font-size: 1.3em;
    font-weight: bold;
    min-width: 30px;
    text-align: center;
  }
  .btn {
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 1.1em;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    color: white;
  }
  .btn:hover { transform: scale(1.1); }
  .btn:active { transform: scale(0.95); }
  .btn-plus { background: linear-gradient(135deg, #4caf50, #2e7d32); }
  .btn-minus { background: linear-gradient(135deg, #f44336, #c62828); }
  .btn-mode {
    background: linear-gradient(135deg, #5c6bc0, #3949ab);
    padding: 8px 12px;
    font-size: 0.85em;
    margin: 3px;
  }
  .btn-mode.active {
    background: linear-gradient(135deg, #4fc3f7, #0288d1);
    box-shadow: 0 0 10px rgba(79,195,247,0.5);
  }
  .btn-reset {
    background: linear-gradient(135deg, #ff9800, #e65100);
    padding: 8px 16px;
    font-size: 0.9em;
    margin-top: 8px;
  }
  .btn-check {
    background: linear-gradient(135deg, #ab47bc, #7b1fa2);
    padding: 10px 20px;
    font-size: 1em;
    margin-top: 8px;
    width: 100%;
  }
  .canvas-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 380px;
  }
  canvas { border-radius: 50%; }
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .info-item {
    background: rgba(0,0,0,0.3);
    padding: 8px 10px;
    border-radius: 8px;
    border-left: 3px solid #4fc3f7;
  }
  .info-item .label {
    font-size: 0.75em;
    color: #90caf9;
    text-transform: uppercase;
  }
  .info-item .val {
    font-size: 1.05em;
    font-weight: bold;
    color: #fff;
  }
  .info-item.full { grid-column: 1 / -1; }
  .mini-table {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 3px;
    margin-top: 8px;
  }
  .mini-table .elem {
    padding: 4px 2px;
    text-align: center;
    border-radius: 5px;
    cursor: pointer;
    font-size: 0.7em;
    font-weight: bold;
    transition: all 0.2s;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .mini-table .elem:hover { transform: scale(1.15); z-index: 2; }
  .mini-table .elem .z { font-size: 0.75em; opacity: 0.8; }
  .mini-table .elem .sym { font-size: 1.1em; }
  .elem-metal { background: #1565c0; color: white; }
  .elem-nonmetal { background: #2e7d32; color: white; }
  .elem-noble { background: #6a1b9a; color: white; }
  .elem-halogen { background: #e65100; color: white; }
  .elem-metalloid { background: #00838f; color: white; }
  .elem-alkali { background: #c62828; color: white; }
  .elem-alkaline { background: #f57f17; color: white; }
  .mode-indicator {
    text-align: center;
    padding: 8px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-weight: bold;
    font-size: 0.95em;
  }
  .mode-free { background: rgba(76,175,80,0.2); border: 1px solid #4caf50; color: #81c784; }
  .mode-quiz { background: rgba(255,152,0,0.2); border: 1px solid #ff9800; color: #ffb74d; }
  .mode-challenge { background: rgba(171,71,188,0.2); border: 1px solid #ab47bc; color: #ce93d8; }
  .quiz-prompt {
    background: rgba(0,0,0,0.4);
    padding: 10px;
    border-radius: 8px;
    margin: 8px 0;
    text-align: center;
    font-size: 1.05em;
    border: 1px dashed #ffb74d;
  }
  .feedback {
    padding: 10px;
    border-radius: 8px;
    margin-top: 8px;
    text-align: center;
    font-weight: bold;
    font-size: 0.95em;
    display: none;
  }
  .feedback.correct { display: block; background: rgba(76,175,80,0.3); border: 1px solid #4caf50; color: #81c784; }
  .feedback.wrong { display: block; background: rgba(244,67,54,0.3); border: 1px solid #f44336; color: #ef9a9a; }
  .charge-indicator {
    text-align: center;
    padding: 6px;
    border-radius: 8px;
    margin-top: 8px;
    font-weight: bold;
  }
  .charge-neutral { background: rgba(76,175,80,0.2); color: #81c784; }
  .charge-positive { background: rgba(244,67,54,0.2); color: #ef9a9a; }
  .charge-negative { background: rgba(33,150,243,0.2); color: #90caf9; }
  .shell-labels {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
    font-size: 0.8em;
    color: #90caf9;
  }
  .shell-labels span { padding: 2px 8px; background: rgba(0,0,0,0.3); border-radius: 4px; }
  .tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .config-display {
    background: rgba(0,0,0,0.4);
    padding: 8px 12px;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    text-align: center;
    margin: 6px 0;
    border: 1px solid rgba(79,195,247,0.3);
    word-break: break-all;
  }
  .distribution-display {
    background: rgba(0,0,0,0.4);
    padding: 8px 12px;
    border-radius: 8px;
    text-align: center;
    margin: 6px 0;
    font-weight: bold;
    font-size: 1.05em;
    border: 1px solid rgba(79,195,247,0.3);
  }
  .score-display {
    text-align: center;
    font-size: 0.9em;
    color: #ffb74d;
    margin-top: 6px;
  }
  .challenge-config {
    background: rgba(171,71,188,0.15);
    border: 1px solid #ab47bc;
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    margin: 8px 0;
  }
  .challenge-config .cfg {
    font-family: 'Courier New', monospace;
    font-size: 1.1em;
    color: #ce93d8;
    margin: 6px 0;
  }
  .legend {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 6px;
    font-size: 0.8em;
    flex-wrap: wrap;
  }
  .legend-item { display: flex; align-items: center; gap: 4px; }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
  .legend-dot.proton { background: #f44336; }
  .legend-dot.neutron { background: #42a5f5; }
  .legend-dot.electron { background: #ffeb3b; }
</style>
</head>
<body>

<div class="header">
  <h1>⚛️ Construtor de Átomos Interativo</h1>
  <p>Simulação do Modelo de Bohr — 9º Ano</p>
</div>

<div class="main-container">
  <!-- LEFT PANEL: Controls -->
  <div class="panel left-panel">
    <div class="panel-title">🎮 Controles</div>
    
    <div class="tabs">
      <button class="btn btn-mode active" onclick="setMode('free')" id="mode-free">🔓 Livre</button>
      <button class="btn btn-mode" onclick="setMode('quiz')" id="mode-quiz"> Quiz</button>
      <button class="btn btn-mode" onclick="setMode('challenge')" id="mode-challenge">🏆 Desafio</button>
    </div>

    <div class="mode-indicator mode-free" id="mode-indicator">Modo Livre — Construa qualquer átomo!</div>

    <div id="quiz-area" style="display:none;">
      <div class="quiz-prompt" id="quiz-prompt">Clique em "Novo Quiz" para começar!</div>
      <button class="btn btn-check" onclick="newQuiz()" id="btn-new-quiz">🎲 Novo Quiz</button>
      <button class="btn btn-check" onclick="checkQuiz()" id="btn-check-quiz" style="background:linear-gradient(135deg,#4caf50,#2e7d32);">✅ Verificar</button>
      <div class="score-display" id="quiz-score">Pontos: 0 | Tentativas: 0</div>
    </div>

    <div id="challenge-area" style="display:none;">
      <div class="challenge-config">
        <div style="font-size:0.85em;color:#ce93d8;">Qual elemento tem esta configuração?</div>
        <div class="cfg" id="challenge-cfg">—</div>
      </div>
      <div class="mini-table" id="challenge-table"></div>
      <div class="score-display" id="challenge-score">Acertos: 0 | Erros: 0</div>
    </div>

    <div id="free-controls">
      <div class="controls-row">
        <label style="color:#f44336;"> Prótons</label>
        <button class="btn btn-minus" onclick="changeParticle('protons',-1)">−</button>
        <span class="value" id="val-protons" style="color:#f44336;">1</span>
        <button class="btn btn-plus" onclick="changeParticle('protons',1)">+</button>
      </div>
      <div class="controls-row">
        <label style="color:#42a5f5;"> Nêutrons</label>
        <button class="btn btn-minus" onclick="changeParticle('neutrons',-1)">−</button>
        <span class="value" id="val-neutrons" style="color:#42a5f5;">0</span>
        <button class="btn btn-plus" onclick="changeParticle('neutrons',1)">+</button>
      </div>
      <div class="controls-row">
        <label style="color:#ffeb3b;"> Elétrons</label>
        <button class="btn btn-minus" onclick="changeParticle('electrons',-1)">−</button>
        <span class="value" id="val-electrons" style="color:#ffeb3b;">1</span>
        <button class="btn btn-plus" onclick="changeParticle('electrons',1)">+</button>
      </div>

      <button class="btn btn-reset" onclick="resetAtom()">🔄 Resetar</button>

      <div class="panel-title" style="margin-top:12px;">📊 Mini Tabela Periódica</div>
      <div class="mini-table" id="mini-table"></div>
    </div>
  </div>

  <!-- CENTER PANEL: Bohr Visualization -->
  <div class="panel center-panel">
    <div class="panel-title">🔬 Modelo de Bohr</div>
    <div class="canvas-container">
      <canvas id="bohr-canvas" width="380" height="380"></canvas>
    </div>
    <div class="shell-labels">
      <span>K (n=1)</span>
      <span>L (n=2)</span>
      <span>M (n=3)</span>
      <span>N (n=4)</span>
    </div>
    <div class="legend">
      <div class="legend-item"><div class="legend-dot proton"></div> Próton</div>
      <div class="legend-item"><div class="legend-dot neutron"></div> Nêutron</div>
      <div class="legend-item"><div class="legend-dot electron"></div> Elétron</div>
    </div>
    <div class="charge-indicator charge-neutral" id="charge-indicator">⚖️ Átomo Neutro</div>
  </div>

  <!-- RIGHT PANEL: Information -->
  <div class="panel right-panel">
    <div class="panel-title"> Informações</div>
    <div class="info-grid">
      <div class="info-item">
        <div class="label">Nome</div>
        <div class="val" id="info-name">Hidrogênio</div>
      </div>
      <div class="info-item">
        <div class="label">Símbolo</div>
        <div class="val" id="info-symbol">H</div>
      </div>
      <div class="info-item">
        <div class="label">Z (nº atômico)</div>
        <div class="val" id="info-z">1</div>
      </div>
      <div class="info-item">
        <div class="label">A (nº de massa)</div>
        <div class="val" id="info-a">1</div>
      </div>
      <div class="info-item">
        <div class="label">Família</div>
        <div class="val" id="info-family">Não-metal</div>
      </div>
      <div class="info-item">
        <div class="label">Período</div>
        <div class="val" id="info-period">1</div>
      </div>
      <div class="info-item full">
        <div class="label">Distribuição Eletrônica (K,L,M,N)</div>
        <div class="distribution-display" id="info-distribution">1</div>
      </div>
      <div class="info-item full">
        <div class="label">Configuração Eletrônica</div>
        <div class="config-display" id="info-config">1s¹</div>
      </div>
      <div class="info-item full">
        <div class="label">Classificação</div>
        <div class="val" id="info-classification">Átomo Neutro</div>
      </div>
    </div>
  </div>
</div>

<script>
// Element data for first 20 elements
const elements = [
  { z:1,  sym:'H',  name:'Hidrogênio',  family:'Não-metal',     period:1, config:'1s¹',           dist:[1],       mass:1 },
  { z:2,  sym:'He', name:'Hélio',       family:'Gás Nobre',     period:1, config:'1s²',           dist:[2],       mass:4 },
  { z:3,  sym:'Li', name:'Lítio',       family:'Metal Alcalino',period:2, config:'1s² 2s¹',       dist:[2,1],     mass:7 },
  { z:4,  sym:'Be', name:'Berílio',     family:'Metal Alcalino-Terroso',period:2, config:'1s² 2s²', dist:[2,2], mass:9 },
  { z:5,  sym:'B',  name:'Boro',        family:'Semimetal',     period:2, config:'1s² 2s² 2p¹',   dist:[2,3],     mass:11 },
  { z:6,  sym:'C',  name:'Carbono',     family:'Não-metal',     period:2, config:'1s² 2s² 2p²',   dist:[2,4],     mass:12 },
  { z:7,  sym:'N',  name:'Nitrogênio',  family:'Não-metal',     period:2, config:'1s² 2s² 2p³',   dist:[2,5],     mass:14 },
  { z:8,  sym:'O',  name:'Oxigênio',    family:'Não-metal',     period:2, config:'1s² 2s² 2p⁴',   dist:[2,6],     mass:16 },
  { z:9,  sym:'F',  name:'Flúor',       family:'Halogênio',     period:2, config:'1s² 2s² 2p⁵',   dist:[2,7],     mass:19 },
  { z:10, sym:'Ne', name:'Neônio',      family:'Gás Nobre',     period:2, config:'1s² 2s² 2p⁶',   dist:[2,8],     mass:20 },
  { z:11, sym:'Na', name:'Sódio',       family:'Metal Alcalino',period:3, config:'1s² 2s² 2p⁶ 3s¹', dist:[2,8,1], mass:23 },
  { z:12, sym:'Mg', name:'Magnésio',    family:'Metal Alcalino-Terroso',period:3, config:'1s² 2s² 2p⁶ 3s²', dist:[2,8,2], mass:24 },
  { z:13, sym:'Al', name:'Alumínio',    family:'Metal',         period:3, config:'1s² 2s² 2p⁶ 3s² 3p¹', dist:[2,8,3], mass:27 },
  { z:14, sym:'Si', name:'Silício',     family:'Semimetal',     period:3, config:'1s² 2s² 2p⁶ 3s² 3p²', dist:[2,8,4], mass:28 },
  { z:15, sym:'P',  name:'Fósforo',     family:'Não-metal',     period:3, config:'1s² 2s² 2p⁶ 3s² 3p³', dist:[2,8,5], mass:31 },
  { z:16, sym:'S',  name:'Enxofre',     family:'Não-metal',     period:3, config:'1s² 2s² 2p 3s² 3p⁴', dist:[2,8,6], mass:32 },
  { z:17, sym:'Cl', name:'Cloro',       family:'Halogênio',     period:3, config:'1s² 2s² 2p⁶ 3s² 3p⁵', dist:[2,8,7], mass:35 },
  { z:18, sym:'Ar', name:'Argônio',     family:'Gás Nobre',     period:3, config:'1s² 2s² 2p⁶ 3s² 3p⁶', dist:[2,8,8], mass:40 },
  { z:19, sym:'K',  name:'Potássio',    family:'Metal Alcalino',period:4, config:'1s² 2s² 2p⁶ 3s² 3p 4s¹', dist:[2,8,8,1], mass:39 },
  { z:20, sym:'Ca', name:'Cálcio',      family:'Metal Alcalino-Terroso',period:4, config:'1s² 2s² 2p⁶ 3s² 3p⁶ 4s²', dist:[2,8,8,2], mass:40 }
];

// State
let protons = 1, neutrons = 0, electrons = 1;
let currentMode = 'free';
let quizTarget = null;
let quizScore = 0, quizAttempts = 0;
let challengeTarget = null;
let challengeCorrect = 0, challengeWrong = 0;
let animAngle = 0;

// Canvas
const canvas = document.getElementById('bohr-canvas');
const ctx = canvas.getContext('2d');

function resizeCanvas() {
  const size = Math.min(380, canvas.parentElement.clientWidth - 20);
  canvas.width = size;
  canvas.height = size;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

// Element class colors
function getElemClass(z) {
  const el = elements.find(e => e.z === z);
  if (!el) return 'elem-nonmetal';
  const f = el.family;
  if (f.includes('Alcalino') && !f.includes('Terroso')) return 'elem-alkali';
  if (f.includes('Alcalino-Terroso')) return 'elem-alkaline';
  if (f === 'Gás Nobre') return 'elem-noble';
  if (f === 'Halogênio') return 'elem-halogen';
  if (f === 'Semimetal') return 'elem-metalloid';
  if (f === 'Metal') return 'elem-metal';
  return 'elem-nonmetal';
}

// Build mini table
function buildMiniTable(containerId, clickable) {
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  elements.forEach(el => {
    const div = document.createElement('div');
    div.className = 'elem ' + getElemClass(el.z);
    div.innerHTML = `<div class="z">${el.z}</div><div class="sym">${el.sym}</div>`;
    if (clickable) {
      div.onclick = () => selectElement(el.z);
    }
    container.appendChild(div);
  });
}
buildMiniTable('mini-table', true);
buildMiniTable('challenge-table', true);

function selectElement(z) {
  const el = elements.find(e => e.z === z);
  if (!el) return;
  if (currentMode === 'challenge') {
    checkChallenge(z);
    return;
  }
  protons = el.z;
  neutrons = el.mass - el.z;
  electrons = el.z;
  updateAll();
}

function changeParticle(type, delta) {
  if (type === 'protons') {
    protons = Math.max(1, Math.min(20, protons + delta));
  } else if (type === 'neutrons') {
    neutrons = Math.max(0, Math.min(30, neutrons + delta));
  } else if (type === 'electrons') {
    electrons = Math.max(0, Math.min(30, electrons + delta));
  }
  updateAll();
}

function resetAtom() {
  protons = 1; neutrons = 0; electrons = 1;
  updateAll();
}

function setMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.btn-mode').forEach(b => b.classList.remove('active'));
  document.getElementById('mode-' + mode).classList.add('active');
  
  const indicator = document.getElementById('mode-indicator');
  const freeControls = document.getElementById('free-controls');
  const quizArea = document.getElementById('quiz-area');
  const challengeArea = document.getElementById('challenge-area');

  freeControls.style.display = mode === 'free' ? 'block' : 'none';
  quizArea.style.display = mode === 'quiz' ? 'block' : 'none';
  challengeArea.style.display = mode === 'challenge' ? 'block' : 'none';
  indicator.style.display = mode === 'free' ? 'block' : 'none';

  if (mode === 'free') {
    indicator.className = 'mode-indicator mode-free';
    indicator.textContent = 'Modo Livre — Construa qualquer átomo!';
  } else if (mode === 'quiz') {
    indicator.className = 'mode-indicator mode-quiz';
    indicator.textContent = 'Modo Quiz — Construa o átomo pedido!';
    indicator.style.display = 'block';
  } else if (mode === 'challenge') {
    indicator.className = 'mode-indicator mode-challenge';
    indicator.textContent = 'Modo Desafio — Identifique o elemento!';
    indicator.style.display = 'block';
    newChallenge();
  }
  updateAll();
}

function newQuiz() {
  const idx = Math.floor(Math.random() * elements.length);
  quizTarget = elements[idx];
  document.getElementById('quiz-prompt').innerHTML = 
    ` Construa o átomo de <strong>${quizTarget.name}</strong> (${quizTarget.sym})!<br><small>Z = ${quizTarget.z}</small>`;
  resetAtom();
}

function checkQuiz() {
  if (!quizTarget) { alert('Clique em "Novo Quiz" primeiro!'); return; }
  quizAttempts++;
  const el = elements.find(e => e.z === protons);
  const isCorrect = protons === quizTarget.z && electrons === quizTarget.z && neutrons === (quizTarget.mass - quizTarget.z);
  
  if (isCorrect) {
    quizScore++;
    document.getElementById('quiz-prompt').innerHTML = `✅ <strong>Correto!</strong> Era ${quizTarget.name} (${quizTarget.sym})!`;
    document.getElementById('quiz-prompt').style.borderColor = '#4caf50';
    setTimeout(() => {
      document.getElementById('quiz-prompt').style.borderColor = '#ffb74d';
      newQuiz();
    }, 2000);
  } else {
    let hint = '';
    if (protons !== quizTarget.z) hint += `Prótons: ${protons}/${quizTarget.z} `;
    if (electrons !== quizTarget.z) hint += `Elétrons: ${electrons}/${quizTarget.z} `;
    if (neutrons !== quizTarget.mass - quizTarget.z) hint += `Nêutrons: ${neutrons}/${quizTarget.mass - quizTarget.z}`;
    document.getElementById('quiz-prompt').innerHTML = `❌ Não está correto. ${hint}<br><small>Tente novamente!</small>`;
    document.getElementById('quiz-prompt').style.borderColor = '#f44336';
    setTimeout(() => { document.getElementById('quiz-prompt').style.borderColor = '#ffb74d'; }, 2000);
  }
  document.getElementById('quiz-score').textContent = `Pontos: ${quizScore} | Tentativas: ${quizAttempts}`;
}

function newChallenge() {
  const idx = Math.floor(Math.random() * elements.length);
  challengeTarget = elements[idx];
  document.getElementById('challenge-cfg').textContent = challengeTarget.config;
}

function checkChallenge(z) {
  if (!challengeTarget) return;
  if (z === challengeTarget.z) {
    challengeCorrect++;
    document.getElementById('challenge-cfg').textContent = `✅ Correto! Era ${challengeTarget.name} (${challengeTarget.sym})`;
    setTimeout(newChallenge, 1500);
  } else {
    challengeWrong++;
    const el = elements.find(e => e.z === z);
    document.getElementById('challenge-cfg').textContent = `❌ Não! ${el.sym} tem configuração ${el.config}. Tente outro!`;
    setTimeout(() => { document.getElementById('challenge-cfg').textContent = challengeTarget.config; }, 2000);
  }
  document.getElementById('challenge-score').textContent = `Acertos: ${challengeCorrect} | Erros: ${challengeWrong}`;
}

function getElectronDistribution(numElectrons) {
  const shells = [2, 8, 8, 2];
  const dist = [];
  let remaining = numElectrons;
  for (let i = 0; i < shells.length && remaining > 0; i++) {
    const take = Math.min(shells[i], remaining);
    dist.push(take);
    remaining -= take;
  }
  return dist;
}

function updateAll() {
  document.getElementById('val-protons').textContent = protons;
  document.getElementById('val-neutrons').textContent = neutrons;
  document.getElementById('val-electrons').textContent = electrons;

  const el = elements.find(e => e.z === protons);
  const A = protons + neutrons;
  const charge = protons - electrons;
  const dist = getElectronDistribution(electrons);

  document.getElementById('info-name').textContent = el ? el.name : '—';
  document.getElementById('info-symbol').textContent = el ? el.sym : '—';
  document.getElementById('info-z').textContent = protons;
  document.getElementById('info-a').textContent = A;
  document.getElementById('info-family').textContent = el ? el.family : '—';
  document.getElementById('info-period').textContent = el ? el.period : '—';
  document.getElementById('info-distribution').textContent = dist.join(', ');
  document.getElementById('info-config').textContent = el ? el.config : '—';

  const chargeEl = document.getElementById('charge-indicator');
  const classEl = document.getElementById('info-classification');
  if (charge === 0) {
    chargeEl.className = 'charge-indicator charge-neutral';
    chargeEl.textContent = '⚖️ Átomo Neutro';
    classEl.textContent = 'Átomo Neutro';
  } else if (charge > 0) {
    chargeEl.className = 'charge-indicator charge-positive';
    chargeEl.textContent = `⚡ Cátion (+${charge}) — Íon positivo`;
    classEl.textContent = `Cátion (+${charge})`;
  } else {
    chargeEl.className = 'charge-indicator charge-negative';
    chargeEl.textContent = `⚡ Ânion (${charge}) — Íon negativo`;
    classEl.textContent = `Ânion (${charge})`;
  }

  // Check isotope
  if (el && neutrons !== el.mass - el.z) {
    classEl.textContent += ' | Isótopo';
  }
}

// Bohr model drawing
function drawBohr() {
  const w = canvas.width, h = canvas.height;
  const cx = w / 2, cy = h / 2;
  ctx.clearRect(0, 0, w, h);

  // Background glow
  const bgGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, w/2);
  bgGrad.addColorStop(0, 'rgba(20,30,80,0.3)');
  bgGrad.addColorStop(1, 'rgba(10,14,39,0)');
  ctx.fillStyle = bgGrad;
  ctx.fillRect(0, 0, w, h);

  const shellRadii = [w * 0.13, w * 0.22, w * 0.31, w * 0.40];
  const shellNames = ['K', 'L', 'M', 'N'];
  const dist = getElectronDistribution(electrons);

  // Draw shells
  for (let i = 0; i < dist.length && i < 4; i++) {
    ctx.beginPath();
    ctx.arc(cx, cy, shellRadii[i], 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(79,195,247,0.35)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([6, 4]);
    ctx.stroke();
    ctx.setLineDash([]);

    // Shell label
    ctx.fillStyle = 'rgba(79,195,247,0.5)';
    ctx.font = `${Math.max(9, w*0.028)}px sans-serif`;
    ctx.fillText(shellNames[i], cx + shellRadii[i] + 4, cy - 4);
  }

  // Draw nucleus
  const nucleusRadius = Math.max(12, Math.min(30, 10 + (protons + neutrons) * 0.8));
  const nucGrad = ctx.createRadialGradient(cx - 3, cy - 3, 0, cx, cy, nucleusRadius);
  nucGrad.addColorStop(0, 'rgba(255,200,100,0.6)');
  nucGrad.addColorStop(0.5, 'rgba(200,100,50,0.4)');
  nucGrad.addColorStop(1, 'rgba(100,50,20,0.2)');
  ctx.beginPath();
  ctx.arc(cx, cy, nucleusRadius, 0, Math.PI * 2);
  ctx.fillStyle = nucGrad;
  ctx.fill();
  ctx.strokeStyle = 'rgba(255,200,100,0.4)';
  ctx.lineWidth = 1;
  ctx.stroke();

  // Draw protons and neutrons in nucleus
  const totalNucleons = protons + neutrons;
  const nucleonSize = Math.max(3, Math.min(6, nucleusRadius / Math.sqrt(totalNucleons || 1) * 0.7));
  let angle = 0;
  for (let i = 0; i < protons; i++) {
    const r = nucleusRadius * 0.6 * Math.sqrt(Math.random());
    const a = Math.random() * Math.PI * 2;
    const px = cx + r * Math.cos(a);
    const py = cy + r * Math.sin(a);
    ctx.beginPath();
    ctx.arc(px, py, nucleonSize, 0, Math.PI * 2);
    ctx.fillStyle = '#f44336';
    ctx.fill();
    ctx.strokeStyle = '#b71c1c';
    ctx.lineWidth = 0.5;
    ctx.stroke();
  }
  for (let i = 0; i < neutrons; i++) {
    const r = nucleusRadius * 0.6 * Math.sqrt(Math.random());
    const a = Math.random() * Math.PI * 2;
    const px = cx + r * Math.cos(a);
    const py = cy + r * Math.sin(a);
    ctx.beginPath();
    ctx.arc(px, py, nucleonSize, 0, Math.PI * 2);
    ctx.fillStyle = '#42a5f5';
    ctx.fill();
    ctx.strokeStyle = '#1565c0';
    ctx.lineWidth = 0.5;
    ctx.stroke();
  }

  // Draw electrons orbiting
  const electronSize = Math.max(4, Math.min(7, w * 0.018));
  for (let shell = 0; shell < dist.length && shell < 4; shell++) {
    const numE = dist[shell];
    const radius = shellRadii[shell];
    const speed = 0.015 / (shell + 1);
    const offset = shell * 1.2;

    for (let i = 0; i < numE; i++) {
      const angle = animAngle * speed * (shell % 2 === 0 ? 1 : -1) + (Math.PI * 2 / numE) * i + offset;
      const ex = cx + radius * Math.cos(angle);
      const ey = cy + radius * Math.sin(angle);

      // Electron glow
      const glow = ctx.createRadialGradient(ex, ey, 0, ex, ey, electronSize * 2);
      glow.addColorStop(0, 'rgba(255,235,59,0.6)');
      glow.addColorStop(1, 'rgba(255,235,59,0)');
      ctx.beginPath();
      ctx.arc(ex, ey, electronSize * 2, 0, Math.PI * 2);
      ctx.fillStyle = glow;
      ctx.fill();

      // Electron
      ctx.beginPath();
      ctx.arc(ex, ey, electronSize, 0, Math.PI * 2);
      ctx.fillStyle = '#ffeb3b';
      ctx.fill();
      ctx.strokeStyle = '#f9a825';
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  animAngle += 0.02;
  requestAnimationFrame(drawBohr);
}

drawBohr();
updateAll();
</script>
